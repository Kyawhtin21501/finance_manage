{
  "name": "dailytask",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "pnpm run check && pnpm run build",
    "start": "next start",
    "lint": "eslint",
    "lint:biome": "biome lint .",
    "format": "biome format --write .",
    "check": "biome lint . && tsc --noEmit",
    "vercel-build": "prisma generate && next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "docker:build": "docker build -t dailytask-web .",
    "docker:run": "docker run -p 3000:3000 --env-file .env dailytask-web"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
